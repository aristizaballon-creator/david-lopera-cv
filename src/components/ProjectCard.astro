---
import VideoCarousel from './VideoCarousel.astro';
import type { Proyecto } from '../data/projects';
import { ui, tr, type Lang } from '../i18n';

interface Props {
  proyecto: Proyecto;
  lang: Lang;
}

const { proyecto, lang } = Astro.props;
const t = ui[lang].carrusel;
const horizontales = proyecto.videos.filter((v) => v.tipo === 'horizontal');
const verticales = proyecto.videos.filter((v) => v.tipo === 'vertical');
---

<article
  id={`proyecto-${proyecto.id}`}
  class="exp-card scroll-mt-20 md:scroll-mt-8 relative bg-bg-card border border-cream/10 p-5 sm:p-7 lg:p-8 transition-colors hover:border-orange/40"
>
  <div class="mb-6 max-w-[46rem]">
    <h3 class="font-display text-[1.625rem] tracking-[1px] text-cream mb-1">{proyecto.titulo}</h3>
    <div class="text-[0.75rem] tracking-[2px] uppercase text-gold mb-3 font-medium">{tr(proyecto.rol, lang)}</div>
    <p class="text-[1rem] leading-[1.7] text-cream-dim">{tr(proyecto.descripcion, lang)}</p>
  </div>

  <div class="flex flex-col gap-8">
    {horizontales.length > 0 && (
      <VideoCarousel videos={horizontales} label={t.videos} proyecto={proyecto.titulo} lang={lang} />
    )}
    {verticales.length > 0 && (
      <VideoCarousel videos={verticales} label={t.shorts} proyecto={proyecto.titulo} lang={lang} vertical />
    )}
  </div>
</article>
